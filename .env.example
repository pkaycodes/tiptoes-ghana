# ---------------------------------------------------------
# Tiptoes Ghana — environment
# Copy this file to .env and fill in the values you need.
# Never commit .env.
# ---------------------------------------------------------

# Instagram API with Instagram Login (recommended)
# Create a Meta app, add the Instagram product, then generate
# an access token for @tiptoesghana.
IG_ACCESS_TOKEN=

# Optional: only needed when using Instagram API with
# Facebook Login for Business.
IG_USER_ID=

# Optional overrides
IG_USERNAME=tiptoesghana
IG_GRAPH_VERSION=v23.0
# IG_GRAPH_HOST=https://graph.instagram.com

# How long the server caches a live feed response, in seconds.
FEED_CACHE_SECONDS=60

# Local server
PORT=4174
HOST=0.0.0.0
